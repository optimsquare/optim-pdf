<Window x:Class="OptimPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optim PDF" Icon="Assets/OptimPdf.ico"
        Width="1360" Height="880" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
    <DockPanel>
        <!-- Header: command bar (brand, quick access, search) + ribbon -->
        <StackPanel DockPanel.Dock="Top" Background="{DynamicResource Chrome.Header}">
            <Grid Height="46" Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/OptimPdf-256.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="9,0,0,1" VerticalAlignment="Center" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource Chrome.Text}">
                        <Run Text="Optim" /><Run Text="PDF" Foreground="{DynamicResource Brand.Accent}" />
                    </TextBlock>
                </StackPanel>
                <!-- Quick access: always visible, whatever ribbon tab is open -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="1" Height="20" Background="{DynamicResource Chrome.Border}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource QatButton}" Content="&#xE8E5;" Click="Open_Click" ToolTip="Open (Ctrl+O)" AutomationProperties.Name="Open" />
                    <Button Style="{StaticResource QatButton}" Content="&#xE74E;" Click="Save_Click" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Quick save" />
                    <Button Style="{StaticResource QatButton}" Content="&#xE749;" Click="Print_Click" ToolTip="Print (Ctrl+P)" AutomationProperties.Name="Quick print" />
                    <Border Width="1" Height="20" Background="{DynamicResource Chrome.Border}" Margin="6,0" />
                    <Button Style="{StaticResource QatButton}" Content="&#xE7A7;" Click="Undo_Click" x:Name="QatUndo" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Quick undo" />
                    <Button Style="{StaticResource QatButton}" Content="&#xE7A6;" Click="Redo_Click" x:Name="QatRedo" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Quick redo" />
                </StackPanel>
                <TextBlock x:Name="HeaderDocTitle" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource Chrome.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="16,0" />
                <!-- Search the active document -->
                <Border Grid.Column="3" Width="280" Height="30" CornerRadius="15" VerticalAlignment="Center"
                        Background="{DynamicResource Chrome.SearchBox}" BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Chrome.TextSecondary}" IsHitTestVisible="False" />
                        <TextBlock x:Name="HeaderSearchHint" Text="Search in document" Margin="33,0,0,1" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource Chrome.TextSecondary}" IsHitTestVisible="False" />
                        <TextBox x:Name="HeaderSearch" Margin="28,0,12,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                 Padding="4,0" MinHeight="0" FontSize="12.5" Foreground="{DynamicResource Chrome.Text}" CaretBrush="{DynamicResource Chrome.Text}"
                                 Style="{x:Null}" KeyDown="HeaderSearch_KeyDown" TextChanged="HeaderSearch_TextChanged"
                                 AutomationProperties.Name="Search in document" ToolTip="Type and press Enter (Ctrl+F)" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource QatButton}" Content="&#xE793;" Click="ToggleTheme_Click" ToolTip="Switch light / dark theme" AutomationProperties.Name="Switch theme" />
                    <Button Style="{StaticResource QatButton}" Content="&#xE897;" Click="About_Click" ToolTip="About Optim PDF" AutomationProperties.Name="Help and about" />
                    <Button Style="{StaticResource QatButton}" x:Name="CollapseRibbonButton" Content="&#xE70E;" Click="CollapseRibbon_Click"
                            ToolTip="Collapse the ribbon (Ctrl+F1)" AutomationProperties.Name="Collapse ribbon" />
                </StackPanel>
            </Grid>
            <Border Height="1" Background="{DynamicResource Chrome.Border}" Opacity="0.7" />
            <TabControl x:Name="Ribbon" Padding="8,4,8,6" Margin="8,2,8,0" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource Chrome.Text}" ItemContainerStyle="{StaticResource RibbonTabItem}"
                        PreviewMouseLeftButtonDown="Ribbon_PreviewMouseLeftButtonDown">
                <TabItem Header="Home">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="File" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8E5;" Content="Open" Click="Open_Click" ToolTip="Open a PDF (Ctrl+O)" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE74E;" Content="Save" Click="Save_Click" ToolTip="Save (Ctrl+S)" x:Name="SaveButton" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE792;" Content="Save as" Click="SaveAs_Click" ToolTip="Save as (Ctrl+Shift+S)" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE749;" Content="Print" Click="Print_Click" ToolTip="Print (Ctrl+P)" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Edit" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7A7;" Content="Undo" Click="Undo_Click" x:Name="UndoButton" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7A6;" Content="Redo" Click="Redo_Click" x:Name="RedoButton" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8C8;" Content="Copy" Click="Copy_Click" ToolTip="Copy selected text (Ctrl+C)" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE721;" Content="Find" Click="Find_Click" ToolTip="Search text (Ctrl+F)" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Tools" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8B3;" Content="Select" Checked="Tool_Checked" x:Name="SelectToolHome" CommandParameter="Select" IsChecked="True" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE7E6;" Content="Highlight" Checked="Tool_Checked" CommandParameter="Highlight" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE90A;" Content="Note" Checked="Tool_Checked" CommandParameter="Note" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Document" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE71D;" Content="Combine" Click="Merge_Click" ToolTip="Combine several PDFs into one" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE73F;" Content="Compress" Click="Compress_Click" ToolTip="Reduce file size" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE946;" Content="Properties" Click="Properties_Click" ToolTip="Document properties (Ctrl+D)" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Edit">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Edit" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE7C9;" Content="Select object" Checked="Tool_Checked" CommandParameter="SelectObject"
                                             ToolTip="Click text, an image or a signature to move, resize or delete it" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE70F;" Content="Edit text" Checked="Tool_Checked" CommandParameter="EditText"
                                             ToolTip="Click a line of text to change or delete it" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Add content" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8D2;" Content="Add text" Checked="Tool_Checked" CommandParameter="AddText"
                                             ToolTip="Click to type, or drag a box to wrap text inside it" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xEB9F;" Content="Add image" Checked="Tool_Checked" CommandParameter="AddImage"
                                             ToolTip="Click to place an image, or drag the box it should fill" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Text" Style="{StaticResource RibbonGroup}">
                            <Grid VerticalAlignment="Center" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Font" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="FontPicker" Grid.Column="1" Margin="0,1" SelectionChanged="TextStyle_Changed" />
                                <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="SizePicker" Grid.Row="1" Grid.Column="1" Margin="0,1" IsEditable="True" Text="12"
                                          LostFocus="TextStyle_Changed" SelectionChanged="TextStyle_Changed">
                                    <ComboBoxItem Content="8" /><ComboBoxItem Content="10" /><ComboBoxItem Content="11" /><ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="14" /><ComboBoxItem Content="16" /><ComboBoxItem Content="18" /><ComboBoxItem Content="24" />
                                    <ComboBoxItem Content="32" /><ComboBoxItem Content="48" />
                                </ComboBox>
                                <CheckBox x:Name="BoldPicker" Grid.Column="2" Content="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Click="TextStyle_Changed" />
                                <CheckBox x:Name="ItalicPicker" Grid.Row="1" Grid.Column="2" Content="Italic" Margin="10,0,0,0" VerticalAlignment="Center" Click="TextStyle_Changed" />
                            </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Color" Style="{StaticResource RibbonGroup}">
                            <ComboBox x:Name="EditColorPicker" Width="130" VerticalAlignment="Center" Margin="4,0" SelectedIndex="0" SelectionChanged="ColorPicker_SelectionChanged">
                                <ComboBoxItem Content="Tool default" />
                                <ComboBoxItem Content="Black" />
                                <ComboBoxItem Content="Blue" />
                                <ComboBoxItem Content="Red" />
                                <ComboBoxItem Content="Green" />
                                <ComboBoxItem Content="Yellow" />
                            </ComboBox>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Fill &amp; Sign">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Form" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE762;" Content="Fill form" Checked="Tool_Checked" CommandParameter="Select"
                                             ToolTip="Click any field on the page to type in it; Tab moves to the next field" Click="FillForm_Click" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8D2;" Content="Add text" Checked="Tool_Checked" CommandParameter="AddText"
                                             ToolTip="Click anywhere and type" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE7C9;" Content="Select object" Checked="Tool_Checked" CommandParameter="SelectObject"
                                             ToolTip="Move, resize or delete text and signatures you added" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7B3;" Content="Highlight fields" Click="HighlightFields_Click"
                                        ToolTip="Show or hide the tint on form fields" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE81E;" Content="Flatten" Click="Flatten_Click" ToolTip="Turn form fields into fixed page content" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Prepare form" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8E9;" Content="Text field" Checked="Tool_Checked" CommandParameter="TextField"
                                             ToolTip="Drag a box to add a text field" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE739;" Content="Check box" Checked="Tool_Checked" CommandParameter="CheckBoxField"
                                             ToolTip="Click to add a check box" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE70D;" Content="Dropdown" Checked="Tool_Checked" CommandParameter="DropdownField"
                                             ToolTip="Drag a box to add a dropdown list" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xEE56;" Content="Signature field" Checked="Tool_Checked" CommandParameter="SignatureField"
                                             ToolTip="Drag a box where someone should sign digitally" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Sign" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xEE56;" Content="Sign" Checked="Tool_Checked" CommandParameter="Sign"
                                             ToolTip="Click or drag on a page to place your signature" />
                                <StackPanel VerticalAlignment="Center" Margin="6,0">
                                    <ComboBox x:Name="SignaturePicker" Width="190" Margin="0,1" SelectionChanged="SignaturePicker_SelectionChanged" DisplayMemberPath="Name" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Content="New…" Click="NewSignature_Click" Padding="10,2" Margin="0,0,6,0" />
                                        <Button Content="Delete" Click="DeleteSignature_Click" Padding="10,2" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Digital signature" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xEB95;" Content="Sign digitally" Checked="Tool_Checked" CommandParameter="DigitalSign"
                                             ToolTip="Drag a box where the certificate signature should appear" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8D7;" Content="Sign invisibly" Click="SignInvisibly_Click"
                                        ToolTip="Sign with a certificate without a visible box" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE9D9;" Content="Signatures" Click="Signatures_Click"
                                        ToolTip="Show and validate the document's digital signatures" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Comment">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Select" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8B3;" Content="Select text" Checked="Tool_Checked" CommandParameter="Select" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE7C9;" Content="Select object" Checked="Tool_Checked" CommandParameter="SelectObject"
                                             ToolTip="Move, resize or delete comments and stamps" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Markup text" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE7E6;" Content="Highlight" Checked="Tool_Checked" CommandParameter="Highlight" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8DC;" Content="Underline" Checked="Tool_Checked" CommandParameter="Underline" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8DE;" Content="Strikethrough" Checked="Tool_Checked" CommandParameter="StrikeOut" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Add" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE90A;" Content="Note" Checked="Tool_Checked" CommandParameter="Note" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8D2;" Content="Text box" Checked="Tool_Checked" CommandParameter="FreeText" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xED63;" Content="Draw" Checked="Tool_Checked" CommandParameter="Ink" />
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE8EC;" Content="Stamp" Checked="Tool_Checked" CommandParameter="Stamp" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Options" Style="{StaticResource RibbonGroup}">
                            <Grid VerticalAlignment="Center" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="ColorPicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="ColorPicker_SelectionChanged" Margin="0,1">
                                    <ComboBoxItem Content="Tool default" />
                                    <ComboBoxItem Content="Yellow" />
                                    <ComboBoxItem Content="Green" />
                                    <ComboBoxItem Content="Blue" />
                                    <ComboBoxItem Content="Red" />
                                    <ComboBoxItem Content="Black" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="Stamp" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="StampPicker" Grid.Row="1" Grid.Column="1" SelectedIndex="0" SelectionChanged="StampPicker_SelectionChanged" Margin="0,1">
                                    <ComboBoxItem Content="APPROVED" />
                                    <ComboBoxItem Content="REVIEWED" />
                                    <ComboBoxItem Content="DRAFT" />
                                    <ComboBoxItem Content="CONFIDENTIAL" />
                                    <ComboBoxItem Content="FINAL" />
                                    <ComboBoxItem Content="REJECTED" />
                                </ComboBox>
                            </Grid>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Pages">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Organize" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7AD;" Content="Rotate left" Click="RotateLeft_Click" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7AD;" Content="Rotate right" Click="RotateRight_Click" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE74A;" Content="Move up" Click="MoveUp_Click" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE74B;" Content="Move down" Click="MoveDown_Click" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE74D;" Content="Delete" Click="Delete_Click" ToolTip="Delete the current or selected pages" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Insert" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8E5;" Content="From file" Click="InsertFile_Click" ToolTip="Insert pages from another PDF after the current page" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7C3;" Content="Blank page" Click="InsertBlank_Click" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Output" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8C8;" Content="Extract" Click="Extract_Click" ToolTip="Save selected pages as a new PDF" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8C6;" Content="Split" Click="Split_Click" ToolTip="Split into several PDFs" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE71D;" Content="Combine" Click="Merge_Click" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Page box" Style="{StaticResource RibbonGroup}">
                            <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE7A8;" Content="Crop" Checked="Tool_Checked" CommandParameter="Crop" ToolTip="Drag a rectangle on a page to crop" />
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Protect">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Security" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE72E;" Content="Protect" Click="Protect_Click" ToolTip="Encrypt with passwords and set permissions" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE785;" Content="Remove security" Click="RemoveSecurity_Click" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Redact" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonTool}" Tag="&#xE7A8;" Content="Mark area" Checked="Tool_Checked" CommandParameter="Redact"
                                             ToolTip="Drag over content to mark it for redaction, or click a word" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE721;" Content="Mark text" Click="MarkText_Click"
                                        ToolTip="Mark every occurrence of a word or phrase" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8FB;" Content="Apply" Click="ApplyRedactions_Click" x:Name="ApplyRedactionsButton"
                                        ToolTip="Permanently remove the marked content" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE894;" Content="Clear marks" Click="ClearRedactions_Click" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Privacy" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7BA;" Content="Remove hidden info" Click="Sanitize_Click"
                                    ToolTip="Remove metadata, attachments, scripts and other hidden data" />
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Convert">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Create" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8A5;" Content="From Office" Click="OfficeToPdf_Click"
                                        ToolTip="Create a PDF from Word, Excel or PowerPoint files (uses your installed Microsoft Office)" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xEB9F;" Content="From images" Click="ImagesToPdf_Click" ToolTip="Create a PDF from images (JPEG, PNG, TIFF…)" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Export" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8A5;" Content="To Word" Click="ToWord_Click"
                                        ToolTip="Convert to an editable Word document (uses your installed Microsoft Word)" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE896;" Content="To images" Click="ExportImages_Click" ToolTip="Save pages as PNG, JPEG or TIFF" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Recognize" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8C1;" Content="Recognize text" Click="Ocr_Click"
                                    ToolTip="Make scanned pages searchable (OCR)" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Many files" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8F1;" Content="Batch" Click="Batch_Click"
                                    ToolTip="Compress, protect, OCR, convert, rename or merge many files at once" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Optimize" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonCommand}" Tag="&#xE73F;" Content="Compress" Click="Compress_Click" ToolTip="Reduce file size" />
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="View">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Zoom" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE71F;" Content="Zoom out" Click="ZoomOut_Click" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8A3;" Content="Zoom in" Click="ZoomIn_Click" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE71E;" Content="Actual size" Click="ActualSize_Click" ToolTip="Ctrl+0" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE9A6;" Content="Fit width" Click="FitWidth_Click" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE740;" Content="Fit page" Click="FitPage_Click" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Rotate view" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7AD;" Content="Left" Click="ViewRotateLeft_Click" ToolTip="Rotate the view only; the file is not changed" />
                                <Button Style="{StaticResource RibbonCommand}" Tag="&#xE7AD;" Content="Right" Click="ViewRotateRight_Click" ToolTip="Rotate the view only; the file is not changed" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Show" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonCommand}" Tag="&#xE8A0;" Content="Side panel" Click="TogglePanel_Click" ToolTip="F4" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Theme" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RibbonButton}" GroupName="Theme" Tag="&#xE706;" Content="Light" x:Name="ThemeLight" Checked="Theme_Checked" />
                                <RadioButton Style="{StaticResource RibbonButton}" GroupName="Theme" Tag="&#xE708;" Content="Dark" x:Name="ThemeDark" Checked="Theme_Checked" />
                                <RadioButton Style="{StaticResource RibbonButton}" GroupName="Theme" Tag="&#xE770;" Content="System" x:Name="ThemeSystem" Checked="Theme_Checked" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="About" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonCommand}" Tag="&#xE946;" Content="About" Click="About_Click" />
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <Border Height="1" Background="{DynamicResource Chrome.Border}" />
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Chrome.Border}" Padding="8,3"
                Background="{DynamicResource Chrome.Header}" TextElement.Foreground="{DynamicResource Chrome.Text}">
            <DockPanel x:Name="StatusBar" IsEnabled="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)" />
                    <TextBlock x:Name="ZoomLabel" Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Click="PrevPage_Click" ToolTip="Previous page" />
                    <TextBox x:Name="PageBox" Width="52" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="PageBox_KeyDown" />
                    <TextBlock x:Name="PageCountLabel" VerticalAlignment="Center" Margin="6,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Click="NextPage_Click" ToolTip="Next page" />
                    <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource Chrome.TextSecondary}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Documents, or the start page when nothing is open -->
        <Grid>
            <TabControl x:Name="DocTabs" Visibility="Collapsed" SelectionChanged="DocTabs_SelectionChanged" Padding="0" Margin="0"
                        Background="{DynamicResource Chrome.TabStrip}" BorderThickness="0" />

            <Grid x:Name="StartPage">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                    <Image Source="Assets/OptimPdf-256.png" Width="96" Height="96" />
                    <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold" Margin="0,14,0,0">
                        <Run Text="Optim" /><Run Text=" PDF" Foreground="{DynamicResource Brand.Accent}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,24" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="View, edit, sign and convert PDFs. Works offline." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Open a PDF…" Click="Open_Click" Padding="20,8" Margin="0,0,10,0" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Combine files…" Click="Merge_Click" Padding="20,8" Margin="0,0,10,0" />
                        <Button Content="PDF from Office…" Click="OfficeToPdf_Click" Padding="20,8" Margin="0,0,10,0" />
                        <Button Content="PDF from images…" Click="ImagesToPdf_Click" Padding="20,8" Margin="0,0,10,0" />
                        <Button Content="Batch…" Click="Batch_Click" Padding="20,8" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="or drop PDF files here" />
                    <TextBlock x:Name="RecentHeader" Text="Recent" FontWeight="SemiBold" Margin="0,28,0,6" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Recent_Click" Tag="{Binding}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="8,5" ToolTip="{Binding}">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
