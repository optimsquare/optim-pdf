<UserControl x:Class="OptimPdf.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OptimPdf.App.ViewModels"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidePanelColumn" Width="250" MinWidth="0" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side panel -->
        <TabControl x:Name="SideTabs" Grid.Column="0" Padding="0" BorderThickness="0" Margin="0,4,0,0">
            <TabItem ToolTip="Page thumbnails">
                <TabItem.Header>
                    <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </TabItem.Header>
                <ListBox x:Name="Thumbnails" ItemsSource="{Binding Pages}" SelectionMode="Extended"
                         BorderThickness="0" Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Thumbnails_SelectionChanged" KeyDown="Thumbnails_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <EventSetter Event="Loaded" Handler="Thumbnail_Loaded" />
                            <EventSetter Event="Unloaded" Handler="Thumbnail_Unloaded" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <StackPanel>
                                <Border Background="White" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        Width="{x:Static vm:PageViewModel.ThumbnailWidth}" Height="{Binding ThumbnailHeight}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem ToolTip="Bookmarks">
                <TabItem.Header>
                    <TextBlock Text="&#xE8A4;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </TabItem.Header>
                <Grid>
                    <TreeView x:Name="Bookmarks" ItemsSource="{Binding Outline}" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="Bookmarks_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:OutlineNode}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock x:Name="NoBookmarks" Text="This document has no bookmarks." Margin="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </TabItem>

            <TabItem ToolTip="Comments">
                <TabItem.Header>
                    <TextBlock Text="&#xE90A;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </TabItem.Header>
                <Grid>
                    <ListBox x:Name="CommentList" ItemsSource="{Binding Comments}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CommentList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CommentItem}">
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                            ToolTip="Delete comment" Click="DeleteComment_Click" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoComments" Text="No comments yet. Use the Comment tab to add highlights, notes, drawings and stamps."
                               Margin="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </TabItem>

            <TabItem x:Name="FormTab" ToolTip="Form fields">
                <TabItem.Header>
                    <TextBlock Text="&#xE762;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </TabItem.Header>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FieldList" ItemsSource="{Binding Fields}" Margin="8,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FieldItem}">
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel Margin="0,0,0,3">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="{Binding}"
                                                    ToolTip="Delete this field" Click="DeleteField_Click" Padding="2" />
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        </DockPanel>
                                        <StackPanel IsEnabled="{Binding Editable}">
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Tag="{Binding}"
                                                 AcceptsReturn="{Binding MultiLine}" TextWrapping="Wrap" MaxHeight="120"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                                                 KeyDown="FieldText_KeyDown" GotFocus="Field_GotFocus" />
                                        <CheckBox IsChecked="{Binding Checked}" Content="Checked" Tag="{Binding}"
                                                  Visibility="{Binding IsCheck, Converter={StaticResource BoolToVisibility}}" GotFocus="Field_GotFocus" />
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}" Tag="{Binding}"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" GotFocus="Field_GotFocus" />
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource Chrome.TextSecondary}"
                                                   Visibility="{Binding IsOther, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoFields" Text="This document has no form fields. Use Fill &amp; Sign › Prepare form to add some." Margin="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </TabItem>

            <TabItem x:Name="SignaturesTab" ToolTip="Digital signatures">
                <TabItem.Header>
                    <TextBlock Text="&#xEB95;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </TabItem.Header>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SignatureList" ItemsSource="{Binding SignatureItems}" Margin="8,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SignatureItem}">
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding StatusBrush}"
                                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Signer}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Button Content="Trust this signer" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2" Tag="{Binding}"
                                                Click="TrustSigner_Click" Visibility="{Binding CanTrust, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Add this signer's certificate to your Trusted People. Only do this if you know the certificate really belongs to them." />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoSignatures" Text="This document has no digital signatures. Use Fill &amp; Sign › Sign digitally to add one."
                               Margin="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </TabItem>

            <TabItem x:Name="SearchTab" ToolTip="Search (Ctrl+F)">
                <TabItem.Header>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </TabItem.Header>
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Search" Click="Search_Click" />
                            <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" />
                        </DockPanel>
                        <WrapPanel Margin="0,6">
                            <CheckBox x:Name="MatchCase" Content="Match case" Margin="0,0,12,0" />
                            <CheckBox x:Name="WholeWord" Content="Whole words" />
                        </WrapPanel>
                        <TextBlock x:Name="SearchStatus" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SearchResults_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchResultItem}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Page}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding Context}" TextWrapping="Wrap" FontSize="12" MaxHeight="34" TextTrimming="WordEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <!-- Banner for signed documents -->
        <Border x:Name="SignatureBanner" Grid.Column="2" VerticalAlignment="Top" Panel.ZIndex="1" Padding="12,6"
                Background="{DynamicResource Chrome.Header}" BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="0,0,0,1"
                Visibility="Collapsed" MouseLeftButtonUp="SignatureBanner_Click" Cursor="Hand" ToolTip="Show signature details">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SignatureBannerIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="SignatureBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Chrome.Text}" />
            </StackPanel>
        </Border>

        <!-- Continuous page view: only visible pages are created (see DocumentView.UpdateVisiblePages). -->
        <ScrollViewer x:Name="Scroller" Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" Focusable="True"
                      ScrollChanged="Scroller_ScrollChanged" SizeChanged="Scroller_SizeChanged" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <Canvas x:Name="PageCanvas" HorizontalAlignment="Center" VerticalAlignment="Top" />
        </ScrollViewer>
    </Grid>
</UserControl>
